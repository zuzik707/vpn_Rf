# === VFS Global ===
VFS_URL=https://visa.vfsglobal.com/uzb/en/lva/login
VFS_EMAIL=your_email@example.com
VFS_PASSWORD=your_password

# === Параметры бронирования ===
# Если появится 3-я подкатегория — добавь через ;
# VFS_SUBCATEGORIES=Work (Visa D) Uzbek, Turkmen;Cargo Drivers (Visa D) Uzbek, Turkmen

# === 2Captcha (primary) ===
# Получить ключ: https://2captcha.com/enterpage — пополнить баланс (~$3)
CAPTCHA_API_KEY=your_2captcha_api_key

# === CapSolver (fallback, опционально) ===
# Получить ключ: https://capsolver.com — при 2 провалах 2Captcha переключится сюда
# CAPSOLVER_API_KEY=your_capsolver_key

# === Telegram ===
# 1. Написать @BotFather -> /newbot -> получить токен
# 2. Написать @userinfobot -> получить свой chat_id
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# === Адаптивные интервалы (секунды) ===
# День (10:00-22:00 local) — агрессивно
CHECK_INTERVAL_DAY_MIN=30
CHECK_INTERVAL_DAY_MAX=60
# Ночь — экономим captcha budget
CHECK_INTERVAL_NIGHT_MIN=180
CHECK_INTERVAL_NIGHT_MAX=300
# После обнаружения слотов — hot mode 15 мин
CHECK_INTERVAL_HOT_MIN=10
CHECK_INTERVAL_HOT_MAX=20
HOT_MODE_DURATION=900

# === Timezone ===
# UTC+5 = Ташкент. Меняй если VPS в другом месте
TIMEZONE_OFFSET=5

# === Тихие часы (local time) — полная пауза ===
QUIET_HOURS_START=2
QUIET_HOURS_END=6

# === Heartbeat — статус в Telegram каждые N часов ===
HEARTBEAT_INTERVAL_HOURS=6

# === Retention — скриншоты старше N часов удаляются (кроме slots_found) ===
SCREENSHOT_RETENTION_HOURS=24

# === Резидентский прокси (опционально, рекомендуется) ===
# Формат: protocol://user:pass@host:port
# PROXY_URL=socks5://user:pass@proxy.example.com:1080
