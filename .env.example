# === VFS Global Settings ===
# URL визового центра VFS Global (например для подачи из РФ на шенген)
VFS_CENTER_URL=https://visa.vfsglobal.com

# Код страны откуда подаёшь (например: rus)
VFS_SOURCE_COUNTRY=rus

# Код страны куда визу (например: fra, deu, ita, esp, etc.)
VFS_DESTINATION_COUNTRY=fra

# Город визового центра (например: Moscow, Saint Petersburg)
VFS_CITY=Moscow

# Категория визы (например: National Visa, Schengen Visa)
VFS_VISA_CATEGORY=Schengen Visa

# Подкатегория (например: Tourism, Business, etc.)
VFS_VISA_SUBCATEGORY=Tourism

# Email и пароль от аккаунта VFS Global
VFS_EMAIL=your_email@example.com
VFS_PASSWORD=your_password

# === Telegram Bot ===
# Токен бота (получить у @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
# Твой chat_id (получить у @userinfobot или @RawDataBot)
TELEGRAM_CHAT_ID=123456789

# === Настройки проверки ===
# Минимальный интервал между проверками (секунды)
CHECK_INTERVAL_MIN=120
# Максимальный интервал (секунды) — реальный будет рандом между min и max
CHECK_INTERVAL_MAX=300

# Тихие часы (не проверять ночью, UTC)
QUIET_HOURS_START=22
QUIET_HOURS_END=6
