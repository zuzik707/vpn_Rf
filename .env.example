# === VFS Global ===
VFS_URL=https://visa.vfsglobal.com/uzb/en/lva/login
VFS_EMAIL=your_email@example.com
VFS_PASSWORD=your_password

# === 2Captcha ===
# Получить ключ: https://2captcha.com/enterpage — пополнить баланс (~$3)
CAPTCHA_API_KEY=your_2captcha_api_key

# === Telegram ===
# 1. Написать @BotFather -> /newbot -> получить токен
# 2. Написать @userinfobot -> получить свой chat_id
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_CHAT_ID=123456789

# === Интервалы (секунды) ===
CHECK_INTERVAL_MIN=180
CHECK_INTERVAL_MAX=420

# === Тихие часы (UTC) — ночью не проверяем ===
QUIET_HOURS_START=23
QUIET_HOURS_END=5
