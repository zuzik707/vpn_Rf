[Unit]
Description=VFS Global Slot Detector v4.0 (UZB→LVA)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/root/vpn_Rf
ExecStart=/usr/bin/xvfb-run --auto-servernum --server-args="-screen 0 1920x1080x24 -nolisten tcp" /root/vfs_venv/bin/python3 /root/vpn_Rf/main.py
Restart=always
RestartSec=60
StartLimitIntervalSec=600
StartLimitBurst=5

# 4 CPU / 4 GB RAM VPS — parallel multi-account
MemoryMax=3500M
MemoryHigh=3000M
CPUQuota=350%
LimitNOFILE=4096

# Logging — Python logging already writes to vfs_monitor.log via RotatingFileHandler
# Don't duplicate by also redirecting stdout/stderr there
StandardOutput=journal
StandardError=journal

# Kill Chrome properly
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
